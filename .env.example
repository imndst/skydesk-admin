# Copy to .env (never commit it). All values are optional for the demo.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@skydesk.demo
ADMIN_PASSWORD=Admin#2026demo
DATABASE_FILE=./data/skydesk.db
# Set to 0 to start with an empty database (only the admin user)
SEED_DEMO_DATA=1
# Requests per minute per IP for /api
RATE_LIMIT_MAX=600
# Failed logins per IP (15 min window) before HTTP 429
LOGIN_MAX_FAILS=5
# Set to 1 ONLY when running behind a reverse proxy you control (trusts X-Forwarded-For)
TRUST_PROXY=0
# Set to 1 to allow the session cookie over plain http (local demo on a production build)
INSECURE_COOKIES=0
